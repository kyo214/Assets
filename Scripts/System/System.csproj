<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>System</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoStandardLib>True</NoStandardLib>
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>False</AppendRuntimeIdentifierToOutputPath>
    <DisableImplicitConfigurationDefines>True</DisableImplicitConfigurationDefines>
    <DisableImplicitFrameworkDefines>True</DisableImplicitFrameworkDefines>
    <DisableImplicitFrameworkReferences>True</DisableImplicitFrameworkReferences>
    <DisableTransitiveProjectReferences>True</DisableTransitiveProjectReferences>
    <DisableImplicitNamespaceImports>True</DisableImplicitNamespaceImports>
    <EnsureRuntimePackageDependencies>False</EnsureRuntimePackageDependencies>
    <AddAdditionalExplicitAssemblyReferences>False</AddAdditionalExplicitAssemblyReferences>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Asterisk.wav" />
    <None Remove="Beep.wav" />
    <None Remove="Exclamation.wav" />
    <None Remove="Hand.wav" />
    <None Remove="Question.wav" />
    <EmbeddedResource Include="Asterisk.wav" LogicalName="Asterisk.wav" />
    <EmbeddedResource Include="Beep.wav" LogicalName="Beep.wav" />
    <EmbeddedResource Include="Exclamation.wav" LogicalName="Exclamation.wav" />
    <EmbeddedResource Include="Hand.wav" LogicalName="Hand.wav" />
    <EmbeddedResource Include="Question.wav" LogicalName="Question.wav" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../mscorlib/mscorlib.csproj" />
    <ProjectReference Include="../Mono.Security/Mono.Security.csproj" />
    <ProjectReference Include="../System.Configuration/System.Configuration.csproj" />
    <ProjectReference Include="../System.Xml/System.Xml.csproj" />
    <ProjectReference Include="../System.Numerics/System.Numerics.csproj" />
    <ProjectReference Include="../System.Core/System.Core.csproj" />
  </ItemGroup>
</Project>